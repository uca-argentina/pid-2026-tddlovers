POSTGRES_USER=appuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=appdb
COOKIE_SECRET=dev-only-cookie-secret-not-for-production-32chars

# A dónde manda el proxy /api de Vite. Con docker compose lo fija el propio
# compose (http://backend:4000); esto es para correr el frontend fuera de
# Docker, donde el backend sí queda en 127.0.0.1.
VITE_BACKEND_URL=http://127.0.0.1:4000
